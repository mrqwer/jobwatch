# обязательно
TELEGRAM_BOT_TOKEN=          # от @BotFather
OWNER_CHAT_ID=               # твой chat_id (напиши боту /start, затем @userinfobot покажет id)
RABBITMQ_PASS=change-me

# hh.ru — app на dev.hh.ru; без них источник hh выключен
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_USER_AGENT=jobwatch/0.1 (you@example.com)

# telegram-каналы — my.telegram.org -> API development tools; без них источник выключен
TG_API_ID=
TG_API_HASH=

# LLM-оценка вакансий (бесплатные ключи; инструкция — LLM_SETUP.md). Пустой ключ = провайдер выключен.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
